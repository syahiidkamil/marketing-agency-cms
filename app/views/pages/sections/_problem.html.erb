<section class="problem" id="tentang">
  <div data-reveal>
    <%= cms_text :p, "problem.eyebrow", class: "eyebrow gold" %>
    <p class="problem-text"><%= cms_text :span, "problem.lead" %> <%= cms_text :span, "problem.muted", class: "muted" %> <%= cms_text :span, "problem.close" %></p>
  </div>
  <div class="promise" data-reveal>
    <%= cms_text :span, "promise.label", class: "promise-label" %>
    <p class="promise-title"><%= cms_text :span, "promise.titleLead" %> <%= cms_text :span, "promise.titleHighlight", class: "gold" %></p>
    <%= cms_text :p, "promise.body", class: "promise-body" %>
    <div class="promise-sign"><span class="avatar" aria-hidden="true"></span><%= cms_text :span, "promise.signature" %></div>
  </div>
</section>
